# Global justfile — populates `j` (fuzzy `just --choose`) with launchers.
# These recipes are deliberately trivial; the value is having a single picker
# accessible from any directory, not the wrappers themselves.

# `just` (no args) opens the fuzzy picker
default:
    @just --choose

# Open lazygit in $PWD
lazygit:
    lazygit

# Open Helix in $PWD (forwards args, e.g. `just hx README.md`)
hx *args:
    hx {{args}}

# Open Yazi (terminal file manager) in $PWD
yazi:
    yazi

# Create the tunnel once in any VM that has cloudflared, then put the real UUID into setup.sh
tunnel-login:
    cloudflared tunnel login                    # browser auth -> cert.pem

tunnel-create:
    cloudflared tunnel create eshlox            # prints the UUID; writes <uuid>.json

tunnel-route:
    cloudflared tunnel route dns eshlox localhost.eshlox.net
