{{- if not .name -}}
{{ fail "missing .name in chezmoi data — run: chezmoi edit-config" }}
{{- end -}}
{{- if not .email -}}
{{ fail "missing .email in chezmoi data — run: chezmoi edit-config" }}
{{- end -}}
[user]
	name = {{ .name | quote }}
	email = {{ .email | quote }}
{{- if .signingKey }}
	signingkey = {{ .signingKey | quote }}
{{- end }}
[core]
	editor = hx
{{- if .deployKey }}
	sshCommand = ssh -i '{{ .deployKey | trimSuffix ".pub" }}' -o IdentitiesOnly=yes
{{- end }}
[init]
	defaultBranch = main
[pull]
	rebase = true
{{- if .signingKey }}
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers
[commit]
	gpgsign = true
[tag]
	gpgsign = true
{{- end }}
