# Ghostty terminal config.
# This file defines the foundational palette: every TUI inside the terminal
# (Helix, lazygit, zellij, fzf, delta, bat) inherits the 16 ANSI colors set here.
# Theme everything ONCE here, leave other tools on defaults.

# Catppuccin — auto-switch between Mocha (dark) and Latte (light) variants
# based on the system appearance. Both bundled in Ghostty.
# To browse alternatives:  ghostty +list-themes | grep -i catppuccin
theme = dark:Catppuccin Mocha,light:Catppuccin Latte

# Font — adjust family/size to taste; these are sane defaults.
font-family = JetBrainsMono Nerd Font
font-size   = 14

# Don't beep / flash on bell
audible-bell = false
visual-bell  = false

# Hide the macOS title bar; zellij/starship already show context
window-decoration = false

# Padding around the content; easier on the eyes than flush edges
window-padding-x = 8
window-padding-y = 8

# Enable shell integration features (cwd inheritance, prompt marks, etc.)
shell-integration = detect
